# ============================================================
# KLA BIOREACTOR — SPARGED STIRRED TANK, OXYGEN MASS TRANSFER
# ============================================================
#
# Reference: Thomas et al. (2021), CES 237, 116538.
#            DOI: 10.1016/j.ces.2021.116538
# Target:    k_La ≈ 4.1 hr⁻¹  (literature benchmark at 400 RPM, 0.4 L/min gas)
#
# Physics:
#   Component 0 : dissolved O₂  (Sc = 500)
#   Lagrangian bubbles: injection, buoyancy/drag/added-mass, coalescence,
#   breakup (Hinze criterion, triangle-mode daughter distribution),
#   Kawase k_L (Eq. 17) mass-transfer source deposited onto component 0.
#
# ---------------------------------------------------------------
# Unit conversion reference
# ---------------------------------------------------------------
#   Physical tank diameter  : T  = 0.18 m        => 180 lattice cells
#   Lattice spacing         : dx = T/180          = 1.000e-3 m
#   Impeller diameter       : Di = 0.058 m        => 58 cells  (radius = 29 cells)
#   Impeller off-bottom     : C  = 0.05 m         => 50 cells  => body.center z = -90+50 = -40
#
#   Impeller rotation rate  : N  = 400 RPM  = 41.888 rad/s
#   Speed of sound (thermal LBM): cs = sqrt(γ·T) = sqrt(1.4×0.03333) = 0.2160
#   LB angular velocity     : omega_LB = 0.0005 rad/step
#     => tip speed LB = omega_LB × 29 cells = 0.01450
#     => Ma = 0.01450 / 0.2160 = 0.067  ✓  (stable; cf. stirred_tank_reacting
#        which used omega_LB=0.00025 at 180 RPM → Ma≈0.031)
#   Physical time step      : dt_phys = omega_LB / omega_phys
#                           = 0.0005 / 41.888 = 1.19365e-5 s/step
#
#   Reynolds number (impeller) : Re = N*Di²/ν
#     = (400/60)*(0.058)²/(1e-6) ≈ 22 400
#
#   Kinematic viscosity     : ν_phys = 1e-6 m²/s (water)
#   LB viscosity            : ν_LB   = 0.008  (effective, includes Smagorinsky SGS)
#     Note: ν_LB is tuned for stability — the Smagorinsky SGS closure provides the
#     remaining effective viscosity; molecular ν_LB would be ~2.4e-6 (too small).
#
#   O₂ diffusivity          : D_O2_phys = 2e-9 m²/s   (Sc = 500)
#   LB O₂ diffusivity       : D_O2_LB   = ν_LB / Sc = 0.008 / 500 = 1.6e-5
#     (uses entropic solver to maintain stability at Sc = 500)
#
#   Concentration reference : C_ref = 100 mol/m³
#     => 1 LB_rho unit represents 100 mol/m³ dissolved O₂
#     => O₂ saturation conc: S × C_g = 0.032 × 44.6 = 1.43 mol/m³ = 0.0143 LB_rho
#
#   Gas flow rate           : Q   = 0.4 L/min = 6.67e-6 m³/s
#   Bubble initial diameter : d₀  = 1.1 mm = 1.1e-3 m
#   Bubble initial O₂ conc  : Cg₀ = 1/V_m = 1/0.0224 = 44.6 mol/m³
#   Injection rate          : ṅ = Q/V_b0 ≈ 9568 bubbles/s
#                           = ṅ × dt_phys ≈ 0.114 bub/step total (≈ 0.016 bub/step/point)
#
#   Free surface (liquid top): h_fluid = 0.16 m = 160 cells from bottom
#     => liquid free surface at z = -90 + 160 = 70 LB cells
#
#   Total sim (10 s physical): 10 / 1.19365e-5 ≈ 838 000 steps
#   Coalescence start (2 s physical): 2 / 1.19365e-5 ≈ 167 500 steps
#   Coalescence interval: 33 steps ≈ 395 µs physical (matches benchmark's 5 steps at 79 µs)
#
#   Sparger ring: 7 holes, radius = 15 cells, z = -55 (15 cells below impeller)
#
#   STL geometry notes:
#     pitched_impeller.stl  — designed for radius ≈ 26.7 cells; scale to 29/26.7 ≈ 1.086
#     baffled_wall.stl      — designed for 128-cell tank; scale to 180/128 ≈ 1.406
# ============================================================

max_step = 838000  # ≈ 10 s physical time

# ---------------------------------------------------------------
# Geometry
# ---------------------------------------------------------------
geometry.prob_lo = 0.0 0.0 -90.0
geometry.prob_hi = 180.0 180.0 90.0
geometry.is_periodic = 0 0 0

# ---------------------------------------------------------------
# Grid / time-stepping
# ---------------------------------------------------------------
amr.n_cell  = 180 180 180
amr.max_level = 0
amr.max_grid_size = 32
amr.blocking_factor_x = 2
amr.blocking_factor_y = 1
amr.blocking_factor_z = 1
amr.plot_int = 1000         # every 
amr.print_int = 200
amr.chk_int = 83800        # checkpoint every ~2.4 s physical
amr.file_name_digits = 5

# ---------------------------------------------------------------
# LBM solver
# ---------------------------------------------------------------
lbm.bc_lo = 5 5 5
lbm.bc_hi = 5 5 5
lbm.dx_outer = 1.0
lbm.dt_outer = 1.0

lbm.nu    = 0.032   # effective LBM kinematic viscosity (includes Smagorinsky SGS)
lbm.alpha = 0.032

# One passive scalar: dissolved O₂  (component 0)
# D_O2_LB = nu_LB / Sc = 0.008 / 500 = 1.60e-5
lbm.n_components = 1
lbm.diffusivity_component_0 = 6.40e-5

lbm.initial_temperature = 0.03333
lbm.adiabatic_exponent = 1.4
lbm.save_streaming = 0
lbm.compute_forces = 1

# Enable entropic alpha stabilisation — required for Sc = 500 scalar transport
lbm.use_entropic_components = 1
lbm.clamp_component_densities = 0

# Entropic alpha stabilisation for the main f distribution.
# Required: spill deposits create rho≈3.8 at impeller tips (far from equilibrium).
lbm.use_entropic_f = 1

lbm.body_is_isothermal = 1
lbm.fluid_is_isothermal = 0
lbm.body_temperature = 0.03333

# Free surface (Chiu & Lin 2011 conservative phase-field, Eq. 18)
# Interface at z = 70 LB cells = 160 cells above domain bottom (z=-90)
# = 0.16 m fluid height, leaving 0.02 m headspace — matches benchmark (3.9 L fill).
# gamma = 1.0 (default: compression coefficient = |u|).
lbm.free_surface       = 1
lbm.free_surface_z     = 70.0   # LB cell z-coordinate of the gas-liquid interface
lbm.free_surface_gamma = 1.0    # multiplier: actual gamma = gamma_coeff * |u|
# Surface tension (Laplace pressure ABB BC, Schwarzmeier 2023 Eq.11-14).
# σ_LB = σ_phys * dt² / (ρ_phys * dx³)
#       = 0.072 * (1.19365e-5)² / (1000 * (1e-3)³) ≈ 1.026e-5
# Surface tension and contact angle (Schwarzmeier 2023 / Attar & Körner 2009)
# Bo ≈ 4400, We_tip ≈ 600,000 → surface tension negligible at tank scale (correct).
lbm.fslbm_sigma        = 1.026e-5
# Contact angle in degrees (90 = neutral/Körner default; < 90 hydrophilic; > 90 hydrophobic).
# Formula: φ_ghost = φ + cos(θ)·|∇_tangential φ|  (Attar & Körner 2009, Schwarzmeier 2023).
lbm.fslbm_contact_angle = 90.0

# ---------------------------------------------------------------
# Bubble module
# ---------------------------------------------------------------
lbm.enable_bubbles = 1

# Physical scale factors — REQUIRED: these are SI values used by bubble physics.
# dx_phys = physical cell size [m];  dt_phys = omega_LB / omega_phys [s]
# omega_LB = 0.0005 rad/step, omega_phys = 400*2π/60 = 41.888 rad/s
lbm.dx_phys = 1.0e-3       # m  (= T/N_cells = 0.18/180)
lbm.dt_phys = 1.19365e-5   # s  (= omega_LB / omega_phys)

# Concentration reference: 1 LB_rho = 100 mol/m³ dissolved O₂
# O₂ saturation = S × C_g = 0.032 × 44.6 = 1.43 mol/m³ = 0.0143 LB_rho
bubble.O2_concentration_reference = 100.0   # mol/m³ per LB_rho

# ---------------------------------------------------------------
# Sparger (7-hole ring, 15 cells below impeller center)
# ---------------------------------------------------------------
# The benchmark states: 7 × 0.8 mm holes "on the bottom of the gas line
# directly below the impeller" — no radial offset or axial distance given.
# The ring layout below (r=15 mm, 15 mm below impeller centre) is an assumed
# approximation that keeps injection points in separate LB cells within the
# impeller swept volume.
# Ring radius = 15 cells = 15 mm, centre (90, 90), z = -55
# Positions are (x y z) in LB cell coordinates, 7 holes at 360°/7 apart
sparger.n_points       = 7
sparger.flow_rate      = 6.67e-6          # m³/s  (= 0.4 L/min)
sparger.bubble_diameter = 1.1e-3          # m     (initial bubble diameter)
sparger.positions = 105.0 90.0  -55.0 \
                     99.35 101.73 -55.0 \
                     86.66 104.62 -55.0 \
                     76.49  96.51 -55.0 \
                     76.49  83.49 -55.0 \
                     86.66  75.38 -55.0 \
                     99.35  78.27 -55.0

# ---------------------------------------------------------------
# Bubble physics
# ---------------------------------------------------------------
bubble.O2_molar_volume    = 0.0224   # m³/mol  (STP)
bubble.O2_solubility      = 0.032    # dimensionless (Henry solubility)
bubble.O2_initial_conc    = 44.6     # mol/m³ in bubble (= 1/V_m at STP)
bubble.kL_coefficient     = 0.301    # C in k_L = C*(ε*ν)^(1/4) * Sc^(-1/2)
bubble.D_O2               = 2.0e-9  # m²/s     (O₂ in water)
bubble.rho_fluid          = 1000.0  # kg/m³   (water)
bubble.nu_fluid           = 1.0e-6  # m²/s    (water)
bubble.surface_tension    = 0.072   # N/m     (air-water)
bubble.P_atm              = 101325.0 # Pa
bubble.g_grav             = 9.81    # m/s²

# Free surface z used ONLY for Boyle's law hydrostatic pressure correction
# (depth h = z_surf - z_bubble).  Bubble exit is governed by the phase-field
# Φ < 0.5 criterion (via lbm.free_surface = 1), NOT by this threshold.
bubble.free_surface_z     = 70.0    # LB cell coordinate (= -90 + 160)

# Coalescence parameters (Boshenyatov Re_a criterion)
bubble.enable_coalescence      = 1
bubble.coalescence_Re_crit     = 40.0
bubble.coalescence_start_time  = 2.0    # s  (wait for flow to develop)
bubble.coalescence_interval    = 33     # steps between neighbour checks (~395 µs physical, matching benchmark)
# Breakup parameters (Hinze criterion + triangle daughter distribution)
bubble.enable_breakup = 1
bubble.breakup_model  = "triangle"   # mode = 0.2 (80/20 vol split most probable)
# Minimum bubble diameter [m]: daughters below this are not created.
# Prevents runaway fragmentation driven by near-wall epsilon spikes.
# 0.1 mm ≈ physical Hinze limit at peak impeller ε ~ 2000 m²/s³.
bubble.min_diameter   = 1.0e-4       # m  (0.1 mm)
# Maximum local epsilon fed to Hinze criterion [m²/s³].
# M-Star reports peak ε ≈ 10 m²/s³ for this geometry (5L, 400 RPM, 1mm lattice).
# Cap at 50 m²/s³ (5× safety factor) to prevent under-resolved boundary-layer
# spikes from driving unphysical fragmentation.  At 50 m²/s³, D_e ≈ 0.68 mm.
bubble.eps_max        = 50.0         # m²/s³

# Statistics output
bubble.stats_int  = 800             # steps between CSV writes (~0.01 s physical)
bubble.stats_file = "bubble_stats.csv"

# ---------------------------------------------------------------
# Initial conditions
# ---------------------------------------------------------------
lbm.ic_type = "constant"
ic_constant.mach_components = 0.0 0.0 0.0
ic_constant.density = 1.0
ic_constant.initial_temperature = 0.03333
ic_constant.adiabatic_exponent = 1.4

# Component 0: dissolved O₂ — starts fully deaerated (zero)
ic_constant_component_0.mach_components = 0.0 0.0 0.0
ic_constant_component_0.density = 0.0    # 0 mol/m³ (deaerated)
ic_constant_component_0.initial_temperature = 0.03333

# ---------------------------------------------------------------
# Moving body — pitched-blade impeller
# ---------------------------------------------------------------
body.is_moving = true
body.velocity = 0.0 0.0 0.0
body.angular_velocity = 0.0 0.0 0.0005  # rad/step  => 400 RPM physical  (Ma=0.067)
# Impeller centre: horizontal centre of tank, 50 cells off bottom (z = -90+50=-40)
body.center = 90.0 90.0 -40.0

# STL: pitched_impeller.stl is designed for blade_radius ≈ 26.7 cells
# Scale to match Di/2 = 29 cells: 29/26.7 ≈ 1.086
eb2.geom_type = "all_regular"
eb2.stl_file = "pitched_impeller.stl"
eb2.stl_center = 90.0 90.0 -40.0
eb2.stl_scale = 1.086
eb2.stl_reverse_normal = 0

# ---------------------------------------------------------------
# Stationary body — baffled tank wall
# ---------------------------------------------------------------
# baffled_wall.stl is designed for 128-cell tank; scale to 180 cells: 180/128 ≈ 1.406
eb2.stationary_stl_file = "baffled_wall.stl"
eb2.stationary_stl_center = 0.0 0.0 0.0
eb2.stationary_stl_scale = 1.40625
eb2.stationary_stl_reverse_normal = 0

# ---------------------------------------------------------------
# AMReX runtime settings
# ---------------------------------------------------------------
amrex.fpe_trap_invalid = 1
amrex.fpe_trap_zero = 1
amrex.fpe_trap_overflow = 1
# Managed (unified) memory required for CPU-side Lagrangian particle loops.
# Bubble physics runs on CPU with host-pinned copies of all MultiFabs (D2H before
# advance, H2D after deposits).  Managed memory is therefore NOT required, and
# disabling it avoids costly page-migration overhead on large GPU allocations.
amrex.the_arena_is_managed = 0
amrex.abort_on_out_of_gpu_memory = 1
